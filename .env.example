# Copy this file to .env.local on the server. Never commit .env.local.

# Absolute path to the locally downloaded model directory.
MODEL_PATH=/data/models/LLaDA-8B-Instruct

# Dataset root. GSM8K must be stored under $RLDLLM_DATASETS_DIR/gsm8k.
RLDLLM_DATASETS_DIR=/data/datasets

# Optional direct override when the downloaded GSM8K directory has another name.
GSM8K_DATASET_PATH=/data/datasets/gsm8k

# Python package mirror used by uv on the cloud server.
PYPI_INDEX_URL=https://mirrors.aliyun.com/pypi/simple

# Optional: only needed when downloading a gated model from Hugging Face Hub.
# HF_TOKEN=hf_your_token_here

# Keep baseline smoke tests local unless you intentionally enable W&B.
WANDB_MODE=disabled
